{
  "geode": "5.9.0",
  "gd": { "win": "2.2081", "android": "2.2081", "mac": "2.2081", "ios": "2.2081" },
  "version": "v1.0.0",
  "id": "aliou.altpulse",
  "name": "AltPulse",
  "developer": "Aliou Ba",
  "description": "Responsive, preset-driven alternating wave input engine with touch controls and live CPS/FPS telemetry.",
  "resources": { "files": ["resources/*.png"] },
  "settings": {
    "engine-title": { "type": "title", "name": "Alternating Input Engine" },
    "enabled": { "type": "bool", "name": "Engine enabled", "description": "Master switch. The in-level ALT button can also toggle the engine.", "default": true },
    "hold-mode": { "type": "bool", "name": "Hold to spam", "description": "When enabled, either configured keybind or the touch ALT button must be held.", "default": true },
    "spam-intensity": { "type": "float", "name": "Spam intensity", "description": "Scales both input lanes while retaining the selected CPS ceiling.", "default": 1.0, "min": 0.1, "max": 2.0, "control": { "slider": true, "input": true, "arrows": true } },
    "cps": { "type": "float", "name": "Target CPS", "description": "Complete press/release cycles per second.", "default": 12.0, "min": 1.0, "max": 60.0, "control": { "slider": true, "input": true, "arrows": true } },
    "frequency": { "type": "float", "name": "Frequency multiplier", "default": 1.0, "min": 0.25, "max": 4.0, "control": { "slider": true, "input": true, "arrows": true } },
    "input-delay-ms": { "type": "int", "name": "Initial input delay (ms)", "default": 0, "min": 0, "max": 250, "control": { "slider": true, "input": true, "arrows": true } },
    "duty-cycle": { "type": "float", "name": "Press duty cycle", "description": "Fraction of each cycle held down.", "default": 0.50, "min": 0.10, "max": 0.90, "control": { "slider": true, "input": true, "arrows": true } },
    "buffer-ms": { "type": "int", "name": "Input buffer (ms)", "description": "Queues a short start request when gameplay is not yet ready.", "default": 24, "min": 0, "max": 200, "control": { "slider": true, "input": true, "arrows": true } },
    "timing-title": { "type": "title", "name": "Timing & Safety" },
    "max-catchup": { "type": "int", "name": "Max catch-up edges/frame", "description": "Bounds work after a frame hitch and prevents runaway input bursts.", "default": 4, "min": 1, "max": 16, "control": { "slider": true, "input": true, "arrows": true } },
    "release-on-pause": { "type": "bool", "name": "Release on pause/death", "default": true },
    "player-two": { "type": "bool", "name": "Target player 2", "default": false },
    "invert-first": { "type": "bool", "name": "Start with lane B", "default": false },
    "keybind-title": { "type": "title", "name": "Keybinds" },
    "lane-a": { "type": "keybind", "name": "Alternating input A", "description": "First physical input source. Hold mode accepts either lane.", "default": ["Space", "Controller_A"] },
    "lane-b": { "type": "keybind", "name": "Alternating input B", "description": "Second physical input source.", "default": ["Up", "Controller_RB"] },
    "toggle-engine": { "type": "keybind", "name": "Toggle engine", "default": "T" },
    "ui-title": { "type": "title", "name": "HUD" },
    "show-stats": { "type": "bool", "name": "Show CPS / FPS stats", "default": true },
    "button-scale": { "type": "float", "name": "Touch control scale", "default": 1.0, "min": 0.65, "max": 1.50, "control": { "slider": true, "input": true, "arrows": true } },
    "safe-mode": { "type": "bool", "name": "Practice-only safe mode", "description": "Restricts automatic input to Practice Mode.", "default": false }
  }
}
